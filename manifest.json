{
  "manifest_version": 3,
  "name": "Password Anomaly Detector",
  "version": "0.1.0",
  "description": "Collects privacy-preserving password-field typing metrics locally.",
  "permissions": ["notifications", "storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Password Anomaly Detector"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
